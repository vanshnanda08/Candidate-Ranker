  "combination": {
    "per_group_max": 1,
    "essential_fraction_weight": 0.75,
    "nice_fraction_weight": 0.25,
    "assessment_penalty": "unchanged exact skill-name/proficiency rule: multiply by 0.85 for each assessment below 40 matching an expert/advanced skill name",
    "other_weights_and_precision": "unchanged production compute_structured_score and compute_final_score"
  }
