    {
      "id": "python_engineering",
      "rule": "action + Python in one non-negated narrative unit; a bare skill tag does not establish personal implementation"
    },
    {
      "id": "ranking_evaluation",
      "rule": "action + ranking/search/system context + evaluation context + one metric/method alternative in one narrative unit",
